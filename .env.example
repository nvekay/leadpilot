# Local services from docker-compose.yml
DATABASE_URL=postgres://leadpilot:leadpilot@localhost:5433/leadpilot
REDIS_URL=redis://localhost:6380

# Shared secret between the web server and the API (any long random string)
API_INTERNAL_KEY=change-me-to-a-long-random-string
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Claude (without a key the pipeline uses keyword rules instead)
ANTHROPIC_API_KEY=
ANALYZE_MODEL=claude-haiku-5-5
DRAFT_MODEL=claude-sonnet-5-5

# HubSpot private app token; run `pnpm --filter @leadpilot/api hubspot:setup` once after setting it
HUBSPOT_TOKEN=

# Slack app: bot token (chat:write), approvals channel id, signing secret (interactivity URL: <API_URL>/slack/actions)
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=

# Replies through Resend; MAIL_REDIRECT_TO=delivered@resend.dev keeps the public demo from emailing anyone
RESEND_API_KEY=
MAIL_FROM=Northwind Studio <onboarding@resend.dev>
MAIL_REDIRECT_TO=delivered@resend.dev

# Inbound email webhook secret (Postmark inbound URL: <API_URL>/intake/email?token=...)
INBOUND_WEBHOOK_TOKEN=
